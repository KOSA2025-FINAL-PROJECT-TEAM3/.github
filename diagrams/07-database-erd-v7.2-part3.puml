@startuml AMApill_ERD_v7_2_Part3_Security_Appointment_AI

title AMApill ERD v7.2 (Part 3: Auth, Security, Appointment & AI)
footer 2025-12-26 | MySQL 8.0 + PostgreSQL 16

skinparam linetype ortho
skinparam entity {
    BackgroundColor AliceBlue
    BorderColor DarkSlateGray
    ArrowColor DimGray
}

' Layout Control: 2x2 Grid
' [Appointment] [Security]
' [Auth]        [AI]


' ==========================================
' AUTH SERVICE
' ==========================================
package "Auth Service" #LightYellow {
    entity users {
        * id : BIGINT <<PK>>
        --
        email : VARCHAR(255) <<UK>>
        password_hash : VARCHAR(255)
        name : VARCHAR(100)
        phone : VARCHAR(20)
        profile_image : VARCHAR(500)
        user_role : VARCHAR(50)
        customer_role : VARCHAR(50)
        oauth_provider : VARCHAR(50)
        oauth_provider_id : VARCHAR(255)
        active : BOOLEAN
        last_login_at : TIMESTAMP
        is_ai_banned : BOOLEAN
        ai_ban_reason : VARCHAR(255)
        ai_banned_at : DATETIME
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

' ==========================================
' CORE - Security
' ==========================================
package "Security Domain" #LightGray {
    entity abuse_audit_log {
        * id : BIGINT <<PK>>
        --
        user_id : BIGINT <<FK>>
        profile : VARCHAR(50)
        layer : VARCHAR(10)
        action : VARCHAR(20)
        reason : VARCHAR(255)
        input_snapshot : TEXT
        metadata : JSON
        created_at : TIMESTAMP
    }

    entity access_logs {
        * id : BIGINT <<PK>>
        --
        requester_id : BIGINT <<FK>>
        target_id : BIGINT <<FK>>
        family_group_id : BIGINT <<FK>>
        resource_type : VARCHAR(50)
        ip_address : VARCHAR(50)
        created_at : DATETIME
    }

    entity security_audit_logs {
        * id : BIGINT <<PK>>
        --
        event_type : VARCHAR(50)
        actor_id : BIGINT
        actor_ip : VARCHAR(45)
        target_identifier : VARCHAR(255)
        group_id : BIGINT
        metadata : JSON
        created_at : DATETIME
    }
}

' ==========================================
' EXTENDED - Appointment
' ==========================================
package "Appointment Domain" #Lavender {
    entity hospital_appointments {
        * id : BIGINT <<PK>>
        --
        user_id : BIGINT <<FK>>
        created_by : BIGINT <<FK>>
        hospital_name : VARCHAR(100)
        department : VARCHAR(50)
        doctor_name : VARCHAR(50)
        visit_at : DATETIME
        address : VARCHAR(255)
        address_detail : VARCHAR(100)
        latitude : DECIMAL(10,8)
        longitude : DECIMAL(11,8)
        phone_number : VARCHAR(20)
        memo : TEXT
        status : VARCHAR(20)
        completed_at : DATETIME
        completed_by : BIGINT
        cancelled_at : DATETIME
        cancelled_by : BIGINT
        cancel_reason : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity appointment_reminders {
        * id : BIGINT <<PK>>
        --
        appointment_id : BIGINT <<FK>>
        remind_at : DATETIME
        channel : VARCHAR(20)
        time_label : VARCHAR(20)
        status : VARCHAR(20)
        sent_at : DATETIME
        error_message : VARCHAR(500)
        processing_by : VARCHAR(64)
        processing_at : DATETIME
        idempotency_key : VARCHAR(64)
        created_at : TIMESTAMP
    }

    entity appointment_reminder_deliveries {
        * id : BIGINT <<PK>>
        --
        reminder_id : BIGINT <<FK>>
        recipient_user_id : BIGINT <<FK>>
        role : VARCHAR(20)
        status : VARCHAR(20)
        attempt_count : INT
        last_attempt_at : DATETIME
        next_retry_at : DATETIME
        sent_at : DATETIME
        error_message : VARCHAR(500)
        created_at : TIMESTAMP
    }

    hospital_appointments ||--o{ appointment_reminders
    appointment_reminders ||--o{ appointment_reminder_deliveries

    ' Internal Horizontal Layout for Appointment Domain
    hospital_appointments -[hidden]right- appointment_reminders
    appointment_reminders -[hidden]right- appointment_reminder_deliveries
}

' ==========================================
' POSTGRESQL SERVICE
' ==========================================
package "AI & Vector Store" #WhiteSmoke {
    entity vector_store {
        * id : uuid <<PK>>
        --
        content : text
        metadata : jsonb
        embedding : vector(1536)
    }
}

' ==========================================
' CROSS-DOMAIN RELATIONSHIPS
' ==========================================
users ||--o{ hospital_appointments
users ||--o{ appointment_reminder_deliveries
users ||--o{ access_logs
users ||--o{ abuse_audit_log
users ||--o{ security_audit_logs

' FORCE GRID LAYOUT (Wide 2-Row)
' Row 1: Appointment Domain (Wide)
' Row 2: Auth Service - AI - Security Domain
"Appointment Domain" -[hidden]down- "Auth Service"
"Auth Service" -[hidden]right- "AI & Vector Store"
"AI & Vector Store" -[hidden]right- "Security Domain"

@enduml
