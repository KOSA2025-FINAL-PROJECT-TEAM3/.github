flowchart TB
  %% Dev 기준(실제 레포 구성: Gateway + Auth + Core + docker-compose)

  subgraph Client["Client"]
    Web["Web / App (Frontend)"]
  end

  subgraph Edge["Edge / Local Proxy (docker-compose)"]
    Nginx["Nginx :80\n- /api/** → Gateway\n- /ws/** → Gateway"]
  end

  subgraph Backend["Backend Services"]
    GW["API Gateway :8080\n(Spring Cloud Gateway)\nJWT 검증 + X-User-* 주입\nRedis 캐싱 + CB + Kafka 로깅"]
    AUTH["Auth Service :8081\n/login, /signup, Kakao OAuth\nJWT 발급/갱신 + 프로필"]
    CORE["Core Service :8082\n가족/약/식단/OCR/알림/리포트/질병/채팅/Voice"]
  end

  subgraph Infra["Infra (docker-compose)"]
    MySQL[("MySQL :3306\nDomain Data")]
    Redis[("Redis :6379\nCache / Token Store")]
    Kafka[("Kafka :9092\nEvent Stream")]
    Postgres[("PostgreSQL+pgvector :5432\nvector_store")]
  end

  Web -->|"HTTP / WebSocket"| Nginx
  Nginx -->|"/api/**"| GW
  Nginx -->|"/ws/**"| GW

  GW -->|"/api/auth/**"| AUTH
  GW -->|"/api/**"| CORE
  GW -->|"/ws/**"| CORE

  AUTH --> MySQL
  AUTH --> Redis

  CORE --> MySQL
  CORE --> Redis
  CORE --> Kafka
  CORE --> Postgres

  subgraph Optional["Optional (docker-compose profiles)"]
    N8N["n8n :5678\n(워크플로우 자동화)"]
    Hocus["Hocuspocus :1234\n(공동편집/실시간)"]
  end

  Redis -.-> Hocus
  Postgres -.-> N8N
